{
  "name": "coderank-functions",
  "version": "0.1.0",
  "private": true,
  "description": "CodeRank trusted backend — Firebase Functions v2 (Node.js 22, TypeScript)",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "jest",
    "import:bank": "node lib/importQuestionBank.js",
    "generate:daily": "node lib/generateDailySet.js"
  },
  "dependencies": {
    "firebase-admin": "^14.4.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.3",
    "jest": "^30.5.1",
    "ts-jest": "^29.4.12",
    "typescript": "~5.9.3"
  }
}
